# Copy to .env (git-ignored) for local runs. In GitHub Actions, set these as repository secrets.

# Pipedrive API token (Settings > Personal preferences > API)
PIPEDRIVE_API_KEY=
# Optional: your company domain, e.g. https://<company>.pipedrive.com
PIPEDRIVE_BASE_URL=

# Shared Drive folders: the live spreadsheet and its monthly archive copies
TARGET_FOLDER_ID=
ARCHIVE_FOLDER_ID=

# Optional: 40-character API key of the "Headcount" deal field (matched by name if unset).
# Find it with: python -m pipedrive_export.pipedrive --list-fields
PIPEDRIVE_HEADCOUNT_FIELD_KEY=

# Optional: PNG/JPG/GIF logo shown on the Dashboard
DASHBOARD_LOGO_URL=

# Local runs only: path to a Google service account key (CI uses Workload Identity)
GOOGLE_APPLICATION_CREDENTIALS=
